generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  username         String   @unique
  usernameOriginal String
  role             String   @default("user")
  createdAt        DateTime @default(now())

  recipes       Recipe[]
  refreshTokens RefreshToken[]
  bookmarks     Bookmark[]
  ratings       RecipeRating[]
  comments      RecipeComment[]
  notifications Notification[]
  recipeEdits   RecipeEdit[]
}

model Recipe {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  description String?
  steps       String[]
  imageUrl    String?
  isGlobal    Boolean  @default(false)
  status      String   @default("draft")
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  category    String?
  difficulty  String?
  cookingTime Int?
  servings    Int?
  cuisine     String?
  dietaryTags String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rejectedReason String?
  reviewedAt     DateTime?

  user        User?          @relation(fields: [userId], references: [id])
  ingredients Ingredient[]
  ratings     RecipeRating[]
  comments    RecipeComment[]
  edits       RecipeEdit[]
}

model RecipeRating {
  id        String   @id @default(uuid())
  recipeId  String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId])
}

model RecipeComment {
  id        String   @id @default(uuid())
  recipeId  String
  userId    String
  text      String
  rating    Int?
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId])
}

model Ingredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  amount   Float
  unit     String

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String
  createdAt DateTime @default(now())
  device    String?
  ip        String?

  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String?
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model RecipeEdit {
  id             String   @id @default(uuid())
  recipeId       String
  userId         String
  status         String   @default("pending")
  title          String
  description    String?
  steps          String[]
  imageUrl       String?
  category       String?
  difficulty     String?
  cookingTime    Int?
  servings       Int?
  cuisine        String?
  dietaryTags    String[]
  ingredients    Json
  rejectedReason String?
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([recipeId])
}